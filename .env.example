# TrackerPro Environment Variables
# Copy this file to .env and replace the placeholder with your actual TMDB API Key

# TMDB API Key (v3 auth)
# Get yours for free at https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=your_tmdb_api_key_here

# Supabase (optional: enables accounts and cloud sync)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
